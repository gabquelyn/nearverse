# Copy to .env. Never commit the real file. Everything here is optional for tests and practice mode.

# Web and scripts
GAME_CONTRACT=
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
FASTAUTH_CLIENT_ID=

# Web server only: pays test funds and relays NEAR Auth sign calls
NEARVERSE_TREASURY_ACCOUNT=
NEARVERSE_TREASURY_PRIVATE_KEY=
NEARVERSE_CLAIM_YOCTO=

# Web server: your own Google and email sign-in. Optional. GOOGLE_LOGIN_SECRET must never change, or every player's wallet changes.
# GOOGLE_CLIENT_ID turns on the Google button. BREVO_API_KEY and EMAIL_FROM turn on email codes.
GOOGLE_CLIENT_ID=
GOOGLE_LOGIN_SECRET=
GOOGLE_PARENT_ACCOUNT=
GOOGLE_PARENT_PRIVATE_KEY=
BREVO_API_KEY=
EMAIL_FROM=

# Ghost traders: choose moves with NEAR AI. Optional. Without a key they use the rules.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_DAILY_CALLS=

# Web server and ghost traders: shows other cars in the world. Optional.
ABLY_API_KEY=

# Web server and price tracker: shared price history for the performance chart. Optional. Server only.
PRICE_DB_URL=
PRICE_DB_KEY=

# Deploy, smoke and ghost trader commands
NEARVERSE_DEPLOYER_ACCOUNT=
NEARVERSE_DEPLOYER_PRIVATE_KEY=
# Receives earned NEAR. Defaults to the deployer.
NEARVERSE_OWNER_ACCOUNT=
