# Copy to .env. Never commit the real file. Everything here is optional for tests and practice mode.

# Web and scripts
GAME_CONTRACT=
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
FASTAUTH_CLIENT_ID=

# Web server only: pays test funds and relays NEAR Auth sign calls
NEARVERSE_TREASURY_ACCOUNT=
NEARVERSE_TREASURY_PRIVATE_KEY=
NEARVERSE_CLAIM_YOCTO=

# Deploy, smoke and ghost trader commands
NEARVERSE_DEPLOYER_ACCOUNT=
NEARVERSE_DEPLOYER_PRIVATE_KEY=
# Receives earned NEAR. Defaults to the deployer.
NEARVERSE_OWNER_ACCOUNT=
